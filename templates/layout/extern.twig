{# =============================================================================
 *  Externes Layout (Tailwind v4 / cb-* Komponenten)
 *
 *  Wrapper für alle nicht-eingeloggten Seiten (Login, Forgot/Reset Password,
 *  Two-Factor, Misc-Notice). Erbt von base.twig, stellt Logo + Card + Footer
 *  bereit und liefert {% block content %} für die jeweilige Page.
 *
 *  Komplett Tailwind-only — base.twig lädt tw.css parallel zu Bulma,
 *  hier wird nur cb-root verwendet.
 ============================================================================= #}
{% extends 'layout/base.twig' %}


{% block body_content %}
<main class="cb-root flex flex-col min-h-screen">

    <section class="flex-1 flex items-center justify-center px-4 py-10">
        <div class="w-full max-w-md">

            {# ── Logo ─────────────────────────────────────────────────── #}
            <div class="mb-8 text-center">
                {% if _white_label.logo_extern_url %}
                    <img src="{{ _white_label.logo_extern_url }}&{{ _globals.cache_control }}"
                         alt="logo" class="mx-auto" style="max-height: 8rem">
                {% else %}
                    <img src="{{ theme_root }}/assets/img/dark/keyhelp{{ _app.is_pro ? '-pro' }}.svg?{{ _globals.cache_control }}"
                         alt="logo" class="mx-auto h-16">
                {% endif %}
            </div>

            {# ── Card ─────────────────────────────────────────────────── #}
            <div class="cb-card cb-card-flush">
                <div class="cb-card-body">

                    {% include 'components/events_tw.twig' %}

                    {% block content %}{% endblock %}

                </div>
            </div>

            {# ── Footer ───────────────────────────────────────────────── #}
            <div class="text-center text-xs text-cb-text-subtle mt-6">
                {% if _white_label.footer %}
                    {{ _white_label.footer|raw }}
                {% else %}
                    {% include 'components/footer/copyright.twig' %}
                {% endif %}
            </div>

        </div>
    </section>

</main>
{% endblock %}
