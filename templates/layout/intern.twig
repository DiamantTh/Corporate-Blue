{% extends 'layout/base.twig' %}


{% block body_content %}
{# Header (Tailwind/cb-* — Bulma-frei) #}
<header id="header">
    <nav id="top-nav">
        <div class="cb-nav-left">
            <a class="cb-nav-item cb-logo" href="{{ _app.home_url }}">
                {% if _white_label.logo_intern_url %}
                    <img src="{{ _white_label.logo_intern_url }}&{{ _globals.cache_control }}" alt="logo">
                {% else %}
                    <img src="theme/bulma/assets/img/dark/keyhelp{{ _app.is_pro ? '-pro' }}.svg?{{ _globals.cache_control }}" alt="logo">
                {% endif %}
            </a>
            <div class="cb-nav-meta max-md:hidden">
                {% if _app.is_demo %}<span>{{ demo_mode }}</span>{% endif %}
                <span>{{ _app.area == 'admin' ? admin_area : client_area }}</span>
                <span id="clock">{{ _globals.time }}</span>
            </div>
        </div>
        <div class="cb-nav-right">
            {% if _app.area == 'client' and _user.can_return_to_admin %}
                <a href="?page=intern&action=return_to_admin" class="cb-nav-item" title="{{ back_to_administrator }}">
                    <span class="inline-flex items-center justify-center w-8 h-8 rounded bg-cb-accent/15 text-cb-accent">
                        <i class="fa-solid fa-angle-left"></i>
                    </span>
                    <span class="max-md:hidden text-sm">{{ back_to_administrator }}</span>
                </a>
            {% endif %}
            <a id="app-user-menu-toggle" href="javascript:void(0)">
                <span class="inline-flex items-center justify-center w-8 h-8 rounded bg-cb-accent/15 text-cb-accent icon">
                    <i class="fa-solid fa-user"></i>
                </span>
                <span class="max-sm:hidden cb-user-meta">
                    {% if _user.full_name %}<span>{{ _user.full_name }}</span>{% endif %}
                    {% if _user.company %}<span>{{ _user.company }}</span>{% endif %}
                    {% if _user.username %}<span>{{ _user.username }}</span>{% endif %}
                </span>
                <span class="icon text-cb-accent"><i class="fa-solid fa-angle-down text-xs"></i></span>
            </a>
            <a id="app-sidebar-toggle" href="javascript:void(0)">
                <span id="app-sidebar-toggle-icon" class="icon">
                    <i class="fa-solid fa-bars text-xl"></i>
                </span>
                <span id="app-sidebar-toggle-icon-active" class="icon is-hidden">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </span>
            </a>
        </div>
    </nav>
</header>

{# User menu (JS-Toggle: .is-hidden) #}
<div id="user-menu" class="is-hidden">
    <a href="?page=profile" class="dropdown-item">
        <span class="icon"><i class="fa-solid fa-user"></i></span>
        {{ profile }}
    </a>

    {% if _app.theme.has_dark_mode %}
        <div class="dropdown-divider"></div>
        <a href="?page=profile&action=switch_theme_mode&last_request_uri={{ _app.request_uri }}" class="dropdown-item">
            <span class="icon"><i class="fas {{ _app.theme.is_dark_mode ? 'fa-sun' : 'fa-moon' }}"></i></span>
            {{ _app.theme.is_dark_mode ? disable_dark_mode : enable_dark_mode }}
        </a>
    {% endif %}

    <div class="dropdown-divider"></div>
    <a href="?page=logout" class="dropdown-item">
        <span class="icon"><i class="fa-solid fa-power-off"></i></span>
        {{ logout }}
    </a>
</div>

{# Sidebar (JS-Toggle: .is-active) #}
<section id="sidebar">
    {% include 'components/sidebar_navigation.twig' %}
</section>

<div id="sidebar-overlay"></div>

{# Main wrapper #}
<section id="content-wrapper">
    <div id="content">
        {% include 'components/breadcrumbs.twig' %}

        <div class="content-title">
            <h1>{{ content_title }}</h1>
        </div>

        {% include 'components/events.twig' %}

        {% block content %}
        {% endblock %}
    </div>

    <footer id="footer">
        {% if _white_label.footer %}
            {{ _white_label.footer|raw }}
        {% else %}
            {% include 'components/footer/icon.twig' %}
            {% include 'components/footer/copyright.twig' %}
            {% include 'components/footer/translation.twig' %}
            {% if not (_white_label.is_hide_keyweb_ads or _app.is_pro) %}
                {% include 'components/footer/ads.twig' %}
            {% endif %}
        {% endif %}
    </footer>
</section>
{% endblock %}