<!DOCTYPE html>
{# =============================================================================
 *  Theme-Root-Pfad — ZENTRAL hier definieren, im gesamten Template-Tree
 *  ueber {{ theme_root }} verwenden. Twig-`set` propagiert via include/extends
 *  in den gesamten Render-Kontext. Wenn der Theme-Ordner umbenannt wird,
 *  muss NUR diese Zeile (+ statische assets/img/favicon/site.webmanifest und
 *  assets/img/favicon/browserconfig.xml) angepasst werden.
 ============================================================================= #}
{% set theme_root = 'theme/Corporate-Blue' %}
<html lang="{{ _app.language }}" dir="{{ _app.text_direction }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# Stop microsoft edge to style numbers, which it assumes are telephone numbers #}
    <meta name="format-detection" content="telephone=no">

    {% if _white_label.favicon_url %}
        <link type="image/x-icon" rel="shortcut icon" href="{{ _white_label.favicon_url }}&{{ _globals.cache_control }}">
    {% else %}
        <link rel="apple-touch-icon" sizes="180x180" href="{{ theme_root }}/assets/img/favicon/apple-touch-icon.png?v=ngk7O7gqB9">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ theme_root }}/assets/img/favicon/favicon-32x32.png?v=ngk7O7gqB9">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ theme_root }}/assets/img/favicon/favicon-16x16.png?v=ngk7O7gqB9">
        <link rel="manifest" href="{{ theme_root }}/assets/img/favicon/site.webmanifest?v=ngk7O7gqB9">
        <link rel="mask-icon" href="{{ theme_root }}/assets/img/favicon/safari-pinned-tab.svg?v=ngk7O7gqB9" color="#2b5797">
        <link rel="shortcut icon" href="{{ theme_root }}/assets/img/favicon/favicon.ico?v=ngk7O7gqB9">
        <meta name="apple-mobile-web-app-title" content="KeyHelp">
        <meta name="application-name" content="KeyHelp">
        <meta name="msapplication-TileColor" content="#2b5797">
        <meta name="msapplication-config" content="{{ theme_root }}/assets/img/favicon/browserconfig.xml?v=ngk7O7gqB9">
        <meta name="theme-color" content="#ffffff">
    {% endif %}

    <title>{{ _app.page_title }}</title>

    {# ─── FontAwesome 7 Free ─────────────────────────────────────────────── #}
    <link rel="stylesheet" href="{{ theme_root }}/assets/css/fontawesome.css?{{ _globals.cache_control }}">

    {# ─── Tailwind v4 (Cyan-Indigo Token-System) ──────────────────────── #}
    {# Bulma-Stylesheet entfernt; tw.css enthaelt cb-* + Bulma-Foundation. #}
    <link rel="stylesheet" href="{{ theme_root }}/assets/css/tw.css?{{ _globals.cache_control }}">

    {% block page_css %}{% endblock %}

    {% if _white_label.css %}
        <style>
            {{ _white_label.css|raw }}
        </style>
    {% endif %}
</head>
<body class="default-mode">
    {% block body_content %}{% endblock %}

    <script>
        var hash = {{ js_hash|raw }};
        Object.freeze(hash);
    </script>
    <script src="{{ theme_root }}/assets/vendor/jquery/jquery.min.js?{{ _globals.cache_control }}"></script>
    <script src="{{ theme_root }}/assets/vendor/perfect-scrollbar/perfect-scrollbar.min.js?{{ _globals.cache_control }}"></script>
    <script src="{{ theme_root }}/assets/vendor/echarts/echarts.min.js"></script>
    <script src="{{ theme_root }}/assets/vendor/handlebars/handlebars.min.js?{{ _globals.cache_control }}"></script>
    <script src="{{ theme_root }}/assets/vendor/tippy/popper.min.js?{{ _globals.cache_control }}"></script>
    <script src="{{ theme_root }}/assets/vendor/tippy/tippy.min.js?{{ _globals.cache_control }}"></script>
    <script src="{{ theme_root }}/assets/vendor/select2/select2.min.js?{{ _globals.cache_control }}"></script>
    <script src="{{ theme_root }}/assets/vendor/select2/i18n/{{ _app.language }}.js?{{ _globals.cache_control }}"></script>
    <script src="{{ theme_root }}/assets/js/functions.js?{{ _globals.cache_control }}"></script>
    <script src="{{ theme_root }}/assets/js/main.js?{{ _globals.cache_control }}"></script>

    {% block page_scripts %}{% endblock %}

    {% if _white_label.javascript %}
        <script type="text/javascript">
            {{ _white_label.javascript|raw }}
        </script>
    {% endif %}
</body>
</html>