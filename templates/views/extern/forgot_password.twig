{% extends 'layout/extern.twig' %}


{% block content %}
    <p class="text-center text-sm text-cb-text mb-4">
        {{ password_reset_instruction }}
    </p>

    <form action="?page=forgot_password" method="post">
        <input type="hidden" name="submit" value="1">

        <div class="cb-field field">
            <label class="cb-label" for="fp-username">{{ username }}</label>
            <input class="cb-input"
                   type="text"
                   id="fp-username"
                   name="username"
                   autofocus
                   required>
        </div>

        <div class="cb-field field">
            <label class="cb-label" for="fp-email">{{ email_address }}</label>
            <input class="cb-input"
                   type="email"
                   id="fp-email"
                   name="email"
                   required>
        </div>

        <div class="mt-4">
            <button type="submit"
                    class="cb-btn cb-btn-primary w-full justify-center app-button-with-loading-animation">
                <span>{{ request_email }}</span>
            </button>
        </div>
    </form>

    <p class="text-center mt-4">
        <a href="index.php" class="text-cb-accent hover:text-cb-accent-hover text-sm">
            {{ back_to_login }}
        </a>
    </p>
{% endblock %}
