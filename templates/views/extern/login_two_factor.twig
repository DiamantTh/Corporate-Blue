{% extends 'layout/extern.twig' %}


{% block content %}
    {% include 'components/browser_requirements_tw.twig' %}

    <form action="?page=login_two_factor" method="post">
        <input type="hidden" name="submit" value="1">
        {{ csrf_field() }}

        {% if _open_page %}
            <input type="hidden" name="open_page" value="{{ _open_page }}">
        {% endif %}

        <div class="cb-field field">
            <label class="cb-label" for="tf-code">{{ auth_code }}</label>
            <input class="cb-input"
                   type="text"
                   id="tf-code"
                   name="auth_code"
                   autocomplete="off"
                   inputmode="numeric"
                   autofocus
                   required>
            {% if auth_code_help %}
                <p class="text-xs text-cb-text-muted mt-1">{{ auth_code_help }}</p>
            {% endif %}
        </div>

        <div class="mt-5">
            <button type="submit"
                    class="cb-btn cb-btn-primary w-full justify-center app-button-with-loading-animation">
                <span>{{ verify }}</span>
            </button>
        </div>
    </form>
{% endblock %}
