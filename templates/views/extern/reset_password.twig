{% extends 'layout/extern.twig' %}


{% block content %}
    <p class="text-center text-sm text-cb-text mb-4">
        {{ reset_password_help }}
    </p>

    <form action="?page=forgot_password" method="post">
        <input type="hidden" name="submit" value="1">
        <input type="hidden" name="request_id" value="{{ _request_id }}">
        <input type="hidden" name="token" value="{{ _token }}">

        {% include 'components/form_password_tw.twig' with { '_is_hide_asterisk': true } %}

        <div class="mt-4">
            <button type="submit" class="cb-btn cb-btn-primary w-full justify-center">
                <span>{{ save }}</span>
            </button>
        </div>
    </form>

    <p class="text-center mt-4">
        <a href="index.php" class="text-cb-accent hover:text-cb-accent-hover text-sm">
            {{ back_to_login }}
        </a>
    </p>
{% endblock %}
