{# =============================================================================
 *  Tailwind-Variante des Passwort-Form-Blocks (Setzen + Bestätigung +
 *  Stärke-Meter + Annotations + Suggestion-Generator).
 *
 *  Original (Bulma) liegt in components/form_password.twig und wird von
 *  intern-Pages weiter genutzt. Hier nur die DOM-Struktur in cb-* / Tailwind
 *  übersetzt — IDs und Klassen, an denen main.js / login.js / functions.js
 *  hängen, bleiben identisch (#password-strength-meter,
 *  #password-annotations, .app-password-annotation-*, .app-show-password,
 *  .app-generate-password, #password-confirmation-missmatch).
 *
 *  Parameter (über `with`):
 *    _is_hide_asterisk  — Asterisk hinter Pflicht-Label unterdrücken
 *    _leave_empty       — true: nicht required, Help-Text "leer lassen"
 ============================================================================= #}

<div class="cb-field field">
    <label class="cb-label" for="fp-password">
        {{ password }}{% if not _leave_empty and not _is_hide_asterisk %} <span class="text-cb-danger">*</span>{% endif %}
    </label>
    <div class="flex gap-2">
        <input class="cb-input flex-1"
               type="password"
               id="fp-password"
               name="password"
               autocomplete="new-password"
               {% if not _leave_empty %}required{% endif %}>
        <button type="button" class="cb-btn cb-btn-ghost app-show-password whitespace-nowrap">
            {{ show }}
        </button>
    </div>
    {% if _leave_empty %}
        <p class="text-xs text-cb-text-muted mt-1">{{ leave_empty }}</p>
    {% endif %}
</div>

<progress id="password-strength-meter" class="cb-progress block w-full mb-2" value="0" max="100">0 %</progress>

<div id="password-annotations" class="text-cb-danger text-xs mb-3">
    <p class="app-password-annotation-caps-lock">{{ password_annotation_caps_lock }}</p>
    <p class="app-password-annotation-min-length">{{ password_complexity_length }}</p>
    <p class="app-password-annotation-letter">{{ password_complexity_letter }}</p>
    <p class="app-password-annotation-lowercase">{{ password_complexity_lowercase }}</p>
    <p class="app-password-annotation-uppercase">{{ password_complexity_uppercase }}</p>
    <p class="app-password-annotation-digit">{{ password_complexity_digit }}</p>
    <p class="app-password-annotation-special">{{ password_complexity_special }}</p>
</div>

<div class="cb-field field">
    <label class="cb-label" for="fp-password-confirmation">
        {{ password_confirmation }}{% if not _leave_empty and not _is_hide_asterisk %} <span class="text-cb-danger">*</span>{% endif %}
    </label>
    <div class="flex gap-2">
        <input class="cb-input flex-1"
               type="password"
               id="fp-password-confirmation"
               name="password_confirmation"
               autocomplete="new-password"
               {% if not _leave_empty %}required{% endif %}>
        <button type="button" class="cb-btn cb-btn-ghost app-show-password whitespace-nowrap">
            {{ show }}
        </button>
    </div>
</div>

<div id="password-confirmation-missmatch" class="text-cb-danger text-xs mb-3">
    <p>{{ password_mismatch }}</p>
</div>

<div class="cb-field field">
    <label class="cb-label" for="fp-password-suggestion">{{ password_suggestion }}</label>
    <div class="flex gap-2">
        <input class="cb-input flex-1"
               type="text"
               id="fp-password-suggestion"
               name="password_suggestion"
               readonly>
        <button type="button" class="cb-btn cb-btn-ghost app-generate-password whitespace-nowrap">
            {{ generate }}
        </button>
    </div>
</div>
