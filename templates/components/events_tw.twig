{# =============================================================================
 *  Events (Tailwind / cb-notif Variante)
 *  Original (Bulma) liegt in components/events.twig und wird von intern-Pages
 *  weiter genutzt. Für TW-Pages zeigen wir App-Events als cb-notif-Boxen.
 ============================================================================= #}
{% set style_map = {
    'info':    'info',
    'success': 'success',
    'warning': 'warning',
    'error':   'danger'
} %}

{% if _app.events|length > 0 %}
    <div class="mb-4">
        {% for event in _app.events %}
            {% set style = style_map[event.type]|default('info') %}
            <div class="cb-notif cb-notif-{{ style }}">
                <div class="flex-1">
                    <p class="cb-notif-body">{{ event.message|raw }}</p>
                </div>
                {% if event.hide_event %}
                    <a href="?page={{ _app.page }}&hide_event={{ event.hide_event }}"
                       class="text-current hover:opacity-75 cursor-pointer app-tooltip"
                       data-tippy-content="{{ hide_this_message }}"
                       aria-label="{{ hide_this_message }}">
                        <i class="fa-solid fa-xmark"></i>
                    </a>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endif %}
