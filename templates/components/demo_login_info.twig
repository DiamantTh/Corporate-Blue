{# =============================================================================
 *  Demo-Login-Hinweise (Tailwind / cb-* Variante)
 *  Original (Bulma) liegt in .archive/demo_login_info.twig.bulma.
 ============================================================================= #}
<div class="mt-6 pt-4 border-t border-cb-border-subtle">

    <p class="text-center text-xs uppercase tracking-wider text-cb-text-muted mb-3">
        {{ keyhelp_demo }}
    </p>

    <p class="text-center text-sm text-cb-text mb-4">
        {{ demo_login_note }}
    </p>

    <div class="grid grid-cols-2 gap-4">
        <div class="text-center">
            <a href="javascript:void(0)"
               class="app-demo-login-link text-cb-accent hover:text-cb-accent-hover font-semibold text-sm"
               data-area="admin">{{ admin_area }}</a>
            <p class="mt-2 text-xs text-cb-text-muted">
                {{ username }}: <b class="text-cb-text">admin</b><br>
                {{ password }}: <b class="text-cb-text">admin</b>
            </p>
        </div>
        <div class="text-center">
            <a href="javascript:void(0)"
               class="app-demo-login-link text-cb-accent hover:text-cb-accent-hover font-semibold text-sm"
               data-area="client">{{ client_area }}</a>
            <p class="mt-2 text-xs text-cb-text-muted">
                {{ username }}: <b class="text-cb-text">client</b><br>
                {{ password }}: <b class="text-cb-text">client</b>
            </p>
        </div>
    </div>

    <table class="cb-table mt-4 text-xs">
        <tbody>
            <tr>
                <td><a href="https://demo.keyhelp.eu" class="text-cb-accent hover:text-cb-accent-hover" rel="nofollow noopener noreferrer" target="_blank">https://demo.keyhelp.eu</a></td>
                <td>English</td>
            </tr>
            <tr>
                <td><a href="https://demo.keyhelp.de" class="text-cb-accent hover:text-cb-accent-hover" rel="nofollow noopener noreferrer" target="_blank">https://demo.keyhelp.de</a></td>
                <td>German / Deutsch</td>
            </tr>
        </tbody>
    </table>

</div>
