{% set class_map = {
    'info':    'cb-event-info',
    'success': 'cb-event-success',
    'warning': 'cb-event-warning',
    'error':   'cb-event-danger'
} %}

{% for event in _app.events %}
    {% set class = class_map[event.type]|default('') %}
    <article class="cb-event {{ class }}">
        <div class="cb-event-body">{{ event.message|raw }}</div>
        {% if event.hide_event %}
            <a href="?page={{ _app.page }}&hide_event={{ event.hide_event }}" class="cb-event-close app-tooltip" data-tippy-content="{{ hide_this_message }}" aria-label="close">
                <i class="fa-solid fa-xmark"></i>
            </a>
        {% endif %}
    </article>
{% endfor %}

